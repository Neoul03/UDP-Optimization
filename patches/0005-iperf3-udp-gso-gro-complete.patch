+#ifndef UDP_GRO
+#define UDP_GRO 104
+#endif
+
+/* --- opt-in kernel UDP_GRO receive (TCP-like: one recvmsg drains a coalesced
+ * super-skb of many datagrams; gso_size cmsg gives the per-datagram size).
+ * Enabled via env IPERF3_UDP_GRO=1 (single-stream UDP test). --- */
+static int  iperf_udp_gro = -1;            /* -1 unknown, 0 off, 1 on */
+static char iperf_udp_gro_buf[262144];
+static int  iperf_udp_seg_size = 0;        /* TX GSO segment size (0 = GSO off) */
+
+/* RX GRO is ON by default in this build (complete GSO+GRO iperf). Set
+ * IPERF3_UDP_GRO=0 to force the legacy per-datagram recv path (for A/B). */
+static int
+udp_gro_on(void)
+{
+    if (iperf_udp_gro < 0) {
+        const char *e = getenv("IPERF3_UDP_GRO");
+        iperf_udp_gro = (e && e[0] == '0') ? 0 : 1;
+    }
+    return iperf_udp_gro;
+}
+
+/* Per-datagram accounting (header, seqno/loss, jitter, bytes) — mirrors the
+ * inline logic of the normal recv path, operating on an arbitrary buffer so it
+ * can be called once per coalesced segment. */
+static void
+iperf_udp_process_pkt(struct iperf_stream *sp, char *buf, int r,
+		      struct iperf_time *arrival_time)
+{
+    struct iperf_test *test = sp->test;
+    uint32_t sec, usec;
+    uint64_t pcount;
+    int first_packet = 0;
+    double transit = 0, d = 0;
+    struct iperf_time sent_time, temp_time;
+
+    if (sp->result->bytes_received == 0)
+        first_packet = 1;
+
+    sp->result->bytes_received += r;
+    sp->result->bytes_received_this_interval += r;
+
+    if (test->udp_counters_64bit) {
+        memcpy(&sec, buf, sizeof(sec));
+        memcpy(&usec, buf + 4, sizeof(usec));
+        memcpy(&pcount, buf + 8, sizeof(pcount));
+        sec = ntohl(sec);
+        usec = ntohl(usec);
+        pcount = be64toh(pcount);
+        sent_time.secs = sec;
+        sent_time.usecs = usec;
+    } else {
+        uint32_t pc;
+        memcpy(&sec, buf, sizeof(sec));
+        memcpy(&usec, buf + 4, sizeof(usec));
+        memcpy(&pc, buf + 8, sizeof(pc));
+        sec = ntohl(sec);
+        usec = ntohl(usec);
+        pcount = ntohl(pc);
+        sent_time.secs = sec;
+        sent_time.usecs = usec;
+    }
+
+    if (pcount >= sp->packet_count + 1) {
+        if (pcount > sp->packet_count + 1)
+            sp->cnt_error += (pcount - 1) - sp->packet_count;
+        sp->packet_count = pcount;
+    } else {
+        sp->outoforder_packets++;
+        if (sp->cnt_error > 0)
+            sp->cnt_error--;
+    }
+
+    iperf_time_diff(arrival_time, &sent_time, &temp_time);
+    transit = iperf_time_in_secs(&temp_time);
+    if (first_packet)
+        sp->prev_transit = transit;
+    d = transit - sp->prev_transit;
+    if (d < 0)
+        d = -d;
+    sp->prev_transit = transit;
+    sp->jitter += (d - sp->jitter) / 16.0;
+}
+
+/* One recvmsg drains a whole coalesced super-skb; split by gso_size. */
+static int
+iperf_udp_recv_gro(struct iperf_stream *sp)
+{
+    struct iperf_test *test = sp->test;
+    struct msghdr msg;
+    struct iovec iov;
+    char ctrl[CMSG_SPACE(sizeof(int))];
+    struct cmsghdr *cm;
+    int gso = 0, off, seg, r;
+
+    int total = 0, ndrain = 0;
+
+    /* Drain all currently-available datagrams in one call so iperf's per-recv
+     * event-loop (select) overhead is amortized over many recvmsgs -- like a
+     * tight recv loop. First recvmsg honours the socket mode; the rest are
+     * MSG_DONTWAIT and stop at EAGAIN. */
+    for (;;) {
+        struct iperf_time arrival_time;
+
+        iov.iov_base = iperf_udp_gro_buf;
+        iov.iov_len = sizeof(iperf_udp_gro_buf);
+        memset(&msg, 0, sizeof(msg));
+        msg.msg_iov = &iov;
+        msg.msg_iovlen = 1;
+        msg.msg_control = ctrl;
+        msg.msg_controllen = sizeof(ctrl);
+
+        r = recvmsg(sp->socket, &msg, total ? MSG_DONTWAIT : 0);
+        if (r <= 0)
+            break;
+        total += r;
+
+        if (test->state != TEST_RUNNING)
+            continue;
+
+        gso = 0;
+        for (cm = CMSG_FIRSTHDR(&msg); cm != NULL; cm = CMSG_NXTHDR(&msg, cm))
+            if (cm->cmsg_level == IPPROTO_UDP && cm->cmsg_type == UDP_GRO)
+                memcpy(&gso, CMSG_DATA(cm), sizeof(gso));
+
+        iperf_time_now(&arrival_time);   /* once per recvmsg, not per segment */
+        seg = (gso > 0) ? gso : r;
+        for (off = 0; off < r; off += seg) {
+            int len = (r - off < seg) ? (r - off) : seg;
+            iperf_udp_process_pkt(sp, iperf_udp_gro_buf + off, len, &arrival_time);
+        }
+        if (++ndrain >= 256)   /* fairness cap across streams */
+            break;
+    }
+
+    return total > 0 ? total : r;
+}
