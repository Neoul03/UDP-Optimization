+static DEFINE_SPINLOCK(net_rx_rings_lock);	/* register/unregister only */
+
+int net_rx_ring_register(long bytes)
+{
+	int i, slot = -1;
+
+	if (bytes <= 0)
+		return -1;
+
+	spin_lock(&net_rx_rings_lock);
+	for (i = 0; i < NET_RX_RING_SLOTS; i++) {
+		if (!net_rx_rings[i].bytes) {
+			net_rx_rings[i].stamp = jiffies;
+			WRITE_ONCE(net_rx_rings[i].bytes, bytes);
+			slot = i;
+			break;
+		}
+	}
