+EXPORT_SYMBOL_GPL(net_rx_ring_register);
+
+void net_rx_ring_unregister(int slot)
+{
+	if (slot < 0 || slot >= NET_RX_RING_SLOTS)
+		return;
+
+	spin_lock(&net_rx_rings_lock);
+	WRITE_ONCE(net_rx_rings[slot].bytes, 0);
+	spin_unlock(&net_rx_rings_lock);
+}
+EXPORT_SYMBOL_GPL(net_rx_ring_unregister);
+
+/* Called from the receive path, so it does the least it can: one store, and
+ * only when the timestamp is actually stale.  Racing writers all write the
+ * same jiffies value.
+ */
+void net_rx_ring_active(int slot)
+{
+	unsigned long now = jiffies;
+
+	if (slot < 0 || slot >= NET_RX_RING_SLOTS)
+		return;
+
+	if (READ_ONCE(net_rx_rings[slot].stamp) != now)
+		WRITE_ONCE(net_rx_rings[slot].stamp, now);
