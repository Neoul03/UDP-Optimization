+			if (leaf->type != CACHE_TYPE_DATA &&
+			    leaf->type != CACHE_TYPE_UNIFIED)
+				continue;
+			if (leaf->level >= level) {
+				level = leaf->level;
+				size = leaf->size;
+			}
+		}
+	}
+	cpus_read_unlock();
+
+	udp_llc_bytes = size;
+	if (size)
+		pr_info("UDP: receive budget sized from L%u cache (%u KiB)\n",
+			level, size >> 10);
+	return 0;
+}
+late_initcall(udp_cache_budget_init);
+
+/* Is UDP already holding more than the cache can usefully keep?
+ *
+ * What costs throughput is not one socket's buffer but the total the receive
+ * path is touching: the NIC's descriptor pages plus every socket's queued
+ * data.  Measured on a single core, goodput is flat while that total stays
+ * inside the last level cache and falls off sharply past it - and the cliff
+ * moves with the cache, not with the buffer: eight sockets at 2MB collapse at
+ * the same aggregate as one socket at 16MB, and masking L3 ways with CAT drags
+ * the knee down in proportion.
+ *
+ * So the bound has to be global.  sk_memory_allocated() already aggregates
+ * across every UDP socket, which is exactly the quantity that matters, so no
+ * new accounting is needed.
+ *
+ * The percentage is left to the operator because the kernel cannot see how
+ * much of the cache is already spoken for: the NIC's rings are invisible from
+ * here (on mlx5 at a 9000-byte MTU a 1024-entry ring pins 16MB), and on a busy
+ * machine other cores are competing for the same cache.  Lower it when either
+ * is true.
+ */
+/* Bytes of receive buffer autotuning has handed out across every UDP socket.
+ *
+ * The first attempt bounded sk_memory_allocated() instead, and it does not
+ * work: that counts memory already queued, and while the consumer keeps up the
+ * queues sit nearly empty - 0.75MB held against 8MB of granted capacity in one
+ * measurement.  So the budget never bites until the queues have already grown
+ * deep, by which point the buffers behind them are several doublings too large.
+ * Occupancy follows capacity rather than the other way round, so capacity is
+ * what has to be bounded.
+ */
+static atomic_long_t udp_rcvbuf_granted;
+
+/* How many sockets that total is spread across, so the sweep below can work
+ * out an even share when it has to take capacity back.
+ */
+static atomic_t udp_rcvbuf_sockets;
+
+/* One step of additive increase.  Small enough that a socket overshooting its
+ * demand by one step wastes little cache, large enough that reaching several
+ * megabytes takes a few hundred steps rather than tens of thousands - and
+ * steps are spent no faster than the queue drains, so a socket taking bursts
+ * every 20us at 56 Gbit/s covers 1MB to 8MB in a couple of milliseconds.
+ */
+#define UDP_RCVBUF_AI_STEP	(64 * 1024)
+
+/* What is left of the cache once the NIC has taken its share.
+ *
+ * Taking a fraction of the cache alone hands out space that does not exist.
+ * The descriptor pages a receive ring pins are part of the same working set as
+ * the queued data, and on this hardware they dominate it: a 1024-entry ring at
+ * a 9000-byte MTU occupies 16MB of an 18MB cache.  Measured with the fraction
+ * left at one half, throughput is 53.88 Gbit/s behind a 128-entry ring and
+ * 29.17 behind the driver's default of 1024, where 43.42 was reachable - the
+ * same setting, opposite outcomes, because the base it applies to was wrong.
+ *
+ * The driver reports its rings in bytes (see linux/netdevice.h); subtracting
+ * them is what makes the fraction mean the same thing on a different machine.
+ */
+static long udp_cache_budget(unsigned int pct)
+{
+	long avail = (long)udp_llc_bytes - net_rx_ring_bytes();
+
+	if (avail < 0)
+		avail = 0;
+
+	return avail * pct / 100;
+}
+
+static bool udp_rmem_over_cache_budget(const struct sock *sk, unsigned int grant)
+{
+	unsigned int pct = READ_ONCE(sock_net(sk)->ipv4.sysctl_udp_rmem_cache_pct);
+	long budget;
+
+	if (!pct || !udp_llc_bytes)
+		return false;
+
+	budget = udp_cache_budget(pct);
+	return atomic_long_read(&udp_rcvbuf_granted) + (long)grant > budget;
+}
+
+/* Commit one autotuning step, moving sk_rcvbuf from @old to @new and both
+ * counters with it.
+ *
+ * This runs without any socket lock: udp_rcvbuf_autotune() is called from
+ * __udp_enqueue_schedule_skb() before it takes the receive queue lock, and a
+ * single socket is fed by as many softirqs as there are receive queues its
+ * senders hash to - which is every multi-sender UDP socket on a multi-queue
+ * NIC.  So the transition has to be claimed rather than assumed: whoever wins
+ * the exchange on sk_rcvbuf is the one that moves the counters, and everyone
+ * else takes the value the winner left and returns.
+ *
+ * Read-modify-write on a plain int would lose updates two ways.  Two growers
+ * would each double from the same old value, so the buffer ends up at twice
+ * what the budget allowed; and the per-socket total would fall behind the
+ * global one, which matters at close, because udp_destruct_common() gives back
+ * the per-socket figure.  Every lost update would leave the global counter
+ * permanently high, and enough of them spend the budget for good - after which
+ * no socket on the machine can grow again until reboot.
+ */
+static bool udp_rcvbuf_commit(struct sock *sk, struct udp_sock *up,
+			      unsigned int old, unsigned int new)
+{
+	if (cmpxchg(&sk->sk_rcvbuf, (int)old, (int)new) != (int)old)
+		return false;
+
+	atomic_long_add((long)new - (long)old, &udp_rcvbuf_granted);
+	atomic_add((int)new - (int)old, &up->rcvbuf_granted);
+	return true;
+}
+
+/* Reclaim from sockets that stopped receiving.
+ *
+ * The shrink path in udp_rcvbuf_autotune() only runs when a packet arrives, so
+ * it returns the allowance of a socket that slowed down but not of one that
+ * went quiet - and a socket that went quiet is the one holding capacity it
+ * certainly is not using.  Nothing else in UDP runs periodically, so there is
+ * no existing place to notice it.
+ *
+ * Measured, with three sockets grown to 4MB and then silenced, a fourth
+ * arriving at 56 Gbit/s was held at its starting 1MB and delivered 33.4
+ * against the 55.5 it managed once those three were closed.  The allowance was
+ * spent on sockets receiving nothing.
+ *
+ * Sweeping the hash is not cheap, so it is armed only by a socket being
+ * refused, which is the only evidence that the allowance is actually
+ * contended, and then no more than once per UDP_BUDGET_SWEEP_DELAY.  An
+ * uncontended machine never runs this at all.
+ */
+#define UDP_BUDGET_SWEEP_DELAY	(HZ / 4)
+
+static void udp_budget_sweep(struct work_struct *work);
+static DECLARE_DELAYED_WORK(udp_budget_work, udp_budget_sweep);
+
+static void udp_budget_pressure(void)
+{
+	/* Racing callers may both queue; the workqueue collapses that to one
+	 * pending run, which is the behaviour wanted.
+	 */
+	schedule_delayed_work(&udp_budget_work, UDP_BUDGET_SWEEP_DELAY);
+}
+
+/* An even share of the allowance, or zero when the allowance is not exceeded.
+ *
+ * Refusing a buffer at socket creation would be the obvious way to hold the
+ * total down, and it is the wrong one: whoever arrives first takes the whole
+ * allowance and everyone after gets what is left, which on the measured case
+ * is one socket at 8MB and seven at nothing.  Taking it back afterwards, in
+ * even shares, converges on the configuration that actually performs - eight
+ * sockets against a 9MB allowance settle near 1.1MB each, which is within
+ * noise of the 1MB that measures best.
+ */
+static unsigned int udp_rcvbuf_fair_share(void)
+{
+	unsigned int pct = READ_ONCE(init_net.ipv4.sysctl_udp_rmem_cache_pct);
+	long budget, held;
+	int n;
+
+	if (!pct || !udp_llc_bytes)
+		return 0;
+
+	budget = udp_cache_budget(pct);
+	held = atomic_long_read(&udp_rcvbuf_granted);
+	if (held <= budget)
+		return 0;
+
+	n = atomic_read(&udp_rcvbuf_sockets);
+	if (n <= 0)
+		return 0;
+
+	return max_t(unsigned int, budget / n, SOCK_MIN_RCVBUF);
+}
+
+static void udp_budget_sweep(struct work_struct *work)
+{
+	unsigned int slot, reclaimed = 0;
+	unsigned int share = udp_rcvbuf_fair_share();
+
+	for (slot = 0; slot <= udp_table.mask; slot++) {
+		struct udp_hslot *hslot = &udp_table.hash[slot];
+		struct sock *sk;
+
+		if (hlist_empty(&hslot->head))
+			continue;
+
+		/* The lock keeps sockets from being unhashed underneath, which
+		 * is what makes it safe to touch sk_rcvbuf here.  Held only for
+		 * one bucket at a time; the enqueue path does not take it.
+		 */
+		spin_lock_bh(&hslot->lock);
+		sk_for_each(sk, &hslot->head) {
+			struct udp_sock *up = udp_sk(sk);
+			unsigned int rcvbuf, give, ufloor, floor;
+			int granted;
+
+			granted = atomic_read(&up->rcvbuf_granted);
+			if (granted <= 0)
+				continue;
+
+			rcvbuf = READ_ONCE(sk->sk_rcvbuf);
+
+			/* Never take a socket under the size it asked for with
+			 * SO_RCVBUF.  Autotuning may have grown it past that -
+			 * the request is a floor now, not a fixed value, see
+			 * udp_rcvbuf_autotune() - and only what autotuning
+			 * added is ours to take back.  Sockets that never asked
+			 * read zero here.
+			 *
+			 * This is also why the cap cannot pull such a socket
+			 * down to the fair share: it bounds the growth it
+			 * granted, not the size the application named.  One
+			 * application asking for more than the cache holds
+			 * still defeats the budget, and nothing here fixes
+			 * that.
+			 */
+			ufloor = (unsigned int)atomic_read(&up->rcvbuf_user);
+
+			/* Over the allowance, take this socket down towards an
+			 * even share whatever its occupancy.  A buffer that is
+			 * too large for the machine is too large while it is
+			 * busy, and waiting for it to look idle is waiting for
+			 * the wrong evidence.
+			 */
+			if (share && rcvbuf > share) {
+				unsigned int want = max_t(unsigned int, share,
+							  ufloor);
+
+				if (rcvbuf <= want)
+					continue;
+				give = min_t(unsigned int, rcvbuf - want,
+					     (unsigned int)granted);
+				if (give && udp_rcvbuf_commit(sk, up, rcvbuf,
+							      rcvbuf - give))
+					reclaimed += give;
+				continue;
+			}
+
+			/* Otherwise the same emptiness test the arrival path
+			 * uses, so a socket is not shrunk here on evidence it
+			 * would not have shrunk on itself.
+			 */
+			if (atomic_read(&sk->sk_rmem_alloc) >= (rcvbuf >> 3))
+				continue;
+
+			/* And the same floor it keeps.  Halving with no floor
+			 * at all would undo what the arrival path protects and
+			 * could leave an idle socket smaller than one that does
+			 * not autotune.  The measured demand is deliberately
+			 * not part of this floor: a socket that went quiet is
+			 * exactly the one whose old demand should be forgotten.
+			 */
+			floor = (unsigned int)READ_ONCE(sysctl_rmem_default);
+			if (ufloor > floor)
+				floor = ufloor;
+			if (rcvbuf <= floor)
+				continue;
+
+			give = min_t(unsigned int, rcvbuf - floor,
+				     min_t(unsigned int, rcvbuf >> 1,
+					   (unsigned int)granted));
+			if (give && udp_rcvbuf_commit(sk, up, rcvbuf,
+						      rcvbuf - give))
+				reclaimed += give;
+		}
+		spin_unlock_bh(&hslot->lock);
+	}
+
+	if (reclaimed)
+		pr_debug("UDP: reclaimed %u KiB of idle receive budget\n",
+			 reclaimed >> 10);
+}
+
+/* UDP receive buffer autotuning, in both directions.
+ *
+ * TCP sizes sk_rcvbuf from its own RTT clock (tcp_rcvbuf_grow); UDP has no
+ * such clock, so the only signal available to the producer is how full the
+ * queue already is.  When the producer finds the queue more than half full the
+ * consumer is losing to the arrival burst, so double sk_rcvbuf rather than
+ * drop at whatever static value rmem_default happened to be; when it finds the
+ * queue below an eighth the buffer is oversized and half of it goes back.
+ *
+ * Growth stops at whichever bound comes first: the per-socket ceiling
+ * net.ipv4.udp_rmem_autotune_max, or the global cache budget above.  The
+ * second is the one that matters - a per-socket limit cannot express "eight
+ * sockets at 4MB is too much" when 4MB is perfectly fine for one.
+ *
+ * Off by default (net.ipv4.udp_rmem_autotune) so that the kernel matches
+ * upstream behaviour unless the knob is set.  A socket that set SO_RCVBUF
+ * keeps exactly what it asked for, but is charged for it - see below.
+ */
+static unsigned int udp_rcvbuf_autotune(struct sock *sk, unsigned int rmem,
+					unsigned int rcvbuf)
+{
+	struct net *net = sock_net(sk);
+	struct udp_sock *up = udp_sk(sk);
+	unsigned int max, grown, target, floor, user;
+
+	if (!READ_ONCE(net->ipv4.sysctl_udp_rmem_autotune))
+		return rcvbuf;
+
+	/* A socket that set SO_RCVBUF never grows here, so without this its
+	 * buffer would be invisible to the budget and the sockets that do
+	 * autotune would keep growing beside it.  Charge what it holds, and
+	 * re-charge if it changes.
+	 *
+	 * Note what this does and does not do: the request is still honoured in
+	 * full, because refusing a size the application asked for outright would
+	 * break a long-standing expectation.  What it buys is that everyone else
+	 * stops compounding the problem - which is the whole difficulty, since a
+	 * 64MB buffer is entirely safe until it is the eighth one.
+	 */
+	/* Charge the buffer the socket already has, once.
+	 *
+	 * The budget bounds what UDP is holding, and the buffer a socket
+	 * starts with is part of that no less than what autotuning adds
+	 * later.  Counting only the additions leaves the baseline invisible,
+	 * and the baseline is not small when there are many sockets: eight at
+	 * a 1MB default are 8MB spoken for before a single grant is made,
+	 * which is most of a budget set at half of an 18MB cache.
+	 *
+	 * Measured with the additions alone counted: eight sockets reached
+	 * 17.8MB between them against a 9MB budget, and delivered 37.63
+	 * where a fixed 1MB buffer delivers 55.70.
+	 *
+	 * The exchange charges exactly one caller, and from then on the field
+	 * is non-zero, so this cannot fire twice.
+	 */
+	if (READ_ONCE(net->ipv4.sysctl_udp_rmem_cache_pct) &&
+	    atomic_cmpxchg(&up->rcvbuf_granted, 0, (int)rcvbuf) == 0) {
+		atomic_long_add(rcvbuf, &udp_rcvbuf_granted);
+		atomic_inc(&udp_rcvbuf_sockets);
+
+		/* A socket arriving with a buffer already too large for what
+		 * is left is the case a growth-only cap cannot see, so arm the
+		 * sweep here as well as on a refused increase.
+		 */
+		if (udp_rmem_over_cache_budget(sk, 0))
+			udp_budget_pressure();
+	}
+
+	/* The cap above runs on its own: it bounds what buffers may sum to and
+	 * needs no opinion about where within the bound any one socket sits.
+	 * Everything below is the sizing, which is separately switched.
+	 */
+	if (!READ_ONCE(net->ipv4.sysctl_udp_rmem_autotune))
+		return rcvbuf;
+
+	/* A socket that called SO_RCVBUF keeps that size as a floor, not as a
+	 * fixed value - it may still grow from here.
+	 *
+	 * Standing aside for SOCK_RCVBUF_LOCK is what TCP does, and copying it
+	 * was wrong here.  In TCP the convention costs nothing because DRS has
+	 * sized receive buffers since 2004 and applications therefore do not
+	 * call SO_RCVBUF.  In UDP they call it precisely because nothing sizes
+	 * the buffer - which is the gap this patch closes.  So the defensive
+	 * call applications make against the missing mechanism was switching the
+	 * mechanism off.
+	 *
+	 * And the value being honoured is not the one the application asked
+	 * for: __sock_set_rcvbuf() clamps the request to rmem_max without
+	 * returning an error (net/core/sock.c), so a 64MB request becomes the
+	 * 416KB that rmem_max allows and setsockopt still reports success.
+	 * Measured, that cost 32% on average and 49% at a 9000-byte MTU.
+	 *
+	 * The request is still honoured in the only sense that matters: the
+	 * socket never ends up with less than it asked for, because the floor
+	 * below keeps shrinking off it.  What changes is that it may end up
+	 * with more, when the measured demand and the cache budget both allow.
+	 *
+	 * Only the first size seen is recorded.  An application that changes
+	 * SO_RCVBUF mid-stream keeps the older floor, which is harmless - the
+	 * demand estimate and rmem_default still apply - and telling that apart
+	 * from autotuning's own writes would need a hook in sock.c, which is
+	 * shared with TCP.
+	 */
+	if (sk->sk_userlocks & SOCK_RCVBUF_LOCK)
+		atomic_cmpxchg(&up->rcvbuf_user, 0, (int)rcvbuf);
+
+	/* Give back what is no longer being used.
+	 *
+	 * Growing alone is not enough, because the budget is a shared allowance
+	 * and nothing returns it.  Measured: a socket that grew to 8MB under 48
+	 * Gbit/s kept all 8MB when its load fell to 4, and a socket arriving
+	 * afterwards could only reach 2MB before the allowance ran out - the one
+	 * holding it needed 1MB and the one that needed room could not have it.
+	 * Left alone, every socket ratchets to its own high-water mark and the
+	 * budget is spent for good.
+	 *
+	 * TCP sizes the buffer from its RTT clock and can therefore shrink as
+	 * well as grow.  UDP has no such clock, so reuse the occupancy signal
+	 * that drives growth, with a wide dead band: grow above a half, shrink
+	 * below an eighth.  Four times' hysteresis keeps a socket sitting near
+	 * either threshold from flapping.
+	 *
+	 * Only what autotuning granted can be taken back, never the buffer the
+	 * socket started with.
+	 */
+	/* Half of the cycle: the queue got far enough up to be worth measuring.
+	 * The other half is the drain below.  Both are needed, because this
+	 * runs on every arrival rather than once per cycle: an empty queue
+	 * taking one packet at a time would otherwise close a "cycle" on each
+	 * of them, whose peak is that single packet, and the demand figure
+	 * would be overwritten with nothing microseconds after it was right.
+	 *
+	 * Measured before this test: a socket taking 128-frame bursts at 56
+	 * Gbit/s never grew at all, sitting at its initial 1MB for the whole
+	 * run and delivering what a fixed 1MB buffer delivers.
+	 */
+	if (rmem > (rcvbuf >> 1))
+		atomic_set(&up->rcvbuf_filled, 1);
+
+	if (rmem < (rcvbuf >> 3)) {
+		int granted = atomic_read(&up->rcvbuf_granted);
+		unsigned int give;
+
+		/* A filled queue has now emptied, so one turn of the consumer
+		 * is over, and what it took over that turn is what the buffer
+		 * has to hold while it takes the next.  Twice it, the same
+		 * factor tcp_rcv_space_adjust() applies over one RTT.
+		 *
+		 * Bytes consumed, not the queue's peak depth.  Depth is bounded
+		 * by sk_rcvbuf, so a larger buffer permits a deeper peak, which
+		 * raises the estimate, which grows the buffer again - a loop
+		 * stopped by the allowance rather than by need, measured
+		 * reaching 9.4MB on a socket that did better at 1MB.
+		 * tcp_rcv_space_adjust() counts what reached the application
+		 * for exactly this reason; buffer size cannot inflate that.
+		 */
+		if (atomic_xchg(&up->rcvbuf_filled, 0)) {
+			int took = atomic_xchg(&up->rcvbuf_consumed, 0);
+
+			if (took > 0)
+				atomic_set(&up->rcvbuf_target, took * 2);
+		}
+
+		if (granted <= 0)
+			return rcvbuf;
+
+		/* Never below the demand just measured.  An empty queue is not
+		 * evidence that the buffer is oversized - a socket taking
+		 * bursts empties between them every time, and is exactly the
+		 * socket that needs the room when the next one lands.  Without
+		 * this the two halves work against each other: giving back half
+		 * on every drain outruns adding a step on every burst, so the
+		 * buffer never accumulates and a bursty socket is pinned at its
+		 * starting size.
+		 *
+		 * Measured on a single socket at 56 Gbit/s with moderation
+		 * delivering 128-frame bursts: 36.70 without this test against
+		 * 55.45 for the doubling it replaced, which is what a fixed 1MB
+		 * buffer gets - it had not grown at all.
+		 */
+		target = (unsigned int)atomic_read(&up->rcvbuf_target);
+
+		/* Now that the whole buffer is charged rather than only what
+		 * autotuning added, "what was granted" no longer marks the
+		 * floor, so take the larger of the measured demand and the
+		 * default the administrator set.  A socket that never asked for
+		 * anything should not end up with less than a socket that does
+		 * not autotune at all.
+		 */
+		floor = (unsigned int)READ_ONCE(sysctl_rmem_default);
+		if (target > floor)
+			floor = target;
+
+		/* And never below what the application asked for with SO_RCVBUF.
+		 * Growing past that size is a service to an application that
+		 * could not know the right number; shrinking under it would be
+		 * overriding a number it did give.
+		 */
+		user = (unsigned int)atomic_read(&up->rcvbuf_user);
+		if (user > floor)
+			floor = user;
+
+		if (rcvbuf <= floor)
+			return rcvbuf;
+
+		give = min_t(unsigned int, rcvbuf - floor,
+			     min_t(unsigned int, rcvbuf >> 1,
+				   (unsigned int)granted));
+		if (!give)
+			return rcvbuf;
+		if (!udp_rcvbuf_commit(sk, up, rcvbuf, rcvbuf - give))
+			return READ_ONCE(sk->sk_rcvbuf);
+		return rcvbuf - give;
+	}
+
+	if (rmem <= (rcvbuf >> 1))
+		return rcvbuf;
+	max = (unsigned int)READ_ONCE(net->ipv4.sysctl_udp_rmem[2]);
+	if (rcvbuf >= max)
+		return rcvbuf;
+
+	/* Grow towards the measured demand, and no further.
+	 *
+	 * A full queue says the arrival rate beat the consumer, but not why,
+	 * and the two cases want opposite things.  A socket taking bursts
+	 * wants the room: its consumer does keep up on average and only needs
+	 * somewhere to put a burst while it works through the last one.  A
+	 * socket whose consumer simply cannot keep up wants no such thing -
+	 * the queue is full at every size, so more of it buys nothing and
+	 * costs the cache, because data then sits longer before it is copied
+	 * out and is evicted before the consumer reaches it.
+	 *
+	 * Occupancy cannot separate them; both answer "full" when asked.  The
+	 * demand figure can, because only a cycle that ended in an empty queue
+	 * produces one.  A socket that never drains never sets a target and so
+	 * never grows, which is what is wanted and needs no separate test.
+	 *
+	 * Measured at 56 Gbit/s on one core with a single socket, where
+	 * moderation delivers no large bursts and the core is already at 100%:
+	 * a fixed 1MB buffer carries 48.89 and a fixed 8MB one 40.57, and
+	 * autotuning that grows on occupancy alone ends up at the second
+	 * figure.
+	 */
+	target = (unsigned int)atomic_read(&up->rcvbuf_target);
+	if (!target || rcvbuf >= target)
+		return rcvbuf;
+	if (target < max)
+		max = target;
+
+	/* Charge the step up front so that concurrent growers see each other's
+	 * grants immediately.  Being refused is also the only signal that the
+	 * allowance is spent, so it is where reclaim gets armed - see
+	 * udp_budget_pressure().
+	 */
+	if (udp_rmem_over_cache_budget(sk, UDP_RCVBUF_AI_STEP)) {
+		udp_budget_pressure();
+		return rcvbuf;
+	}
+
+	/* Add a step rather than doubling.  Where the allowance is contended
+	 * the two differ in more than speed: under a shared limit whose only
+	 * feedback is being refused, additive increase with multiplicative
+	 * decrease converges on an even split, while doubling converges on an
+	 * efficient but arbitrary one - whoever asked first keeps the room.
+	 * That is not hypothetical here, it is what the ratchet measurement
+	 * showed: one socket holding 8MB it no longer needed while the next to
+	 * arrive could reach only 2MB.
+	 */
+	grown = min_t(unsigned int, rcvbuf + UDP_RCVBUF_AI_STEP, max);
+	if (grown <= rcvbuf)
+		return rcvbuf;
+	if (!udp_rcvbuf_commit(sk, up, rcvbuf, grown))
+		return READ_ONCE(sk->sk_rcvbuf);
+	return grown;
+}
