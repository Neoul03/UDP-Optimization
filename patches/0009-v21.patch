+EXPORT_SYMBOL_GPL(net_rx_ring_active);
+
+long net_rx_ring_bytes(void)
+{
+	static unsigned long cached_at;
+	static long cached;
+	unsigned long now = jiffies, cutoff;
+	long total = 0;
+	int i;
+
+	/* The sum is read from the enqueue path, so recompute it at most ten
+	 * times a second and hand back the last answer in between.  What it
+	 * feeds is a budget that moves on the scale of rings opening and
+	 * traffic starting, neither of which needs finer resolution.
+	 */
+	if (READ_ONCE(cached_at) == now)
+		return READ_ONCE(cached);
