+static int __init udp_cache_budget_init(void)
+{
+	unsigned int i, level = 0, size = 0;
+	struct cpu_cacheinfo *ci;
+
+	cpus_read_lock();
+	ci = get_cpu_cacheinfo(raw_smp_processor_id());
+	if (ci && ci->info_list) {
+		for (i = 0; i < ci->num_leaves; i++) {
+			struct cacheinfo *leaf = &ci->info_list[i];
+
+			if (leaf->type != CACHE_TYPE_DATA &&
+			    leaf->type != CACHE_TYPE_UNIFIED)
+				continue;
+			if (leaf->level >= level) {
+				level = leaf->level;
+				size = leaf->size;
+			}
+		}
+	}
+	cpus_read_unlock();
+
+	udp_llc_bytes = size;
+	if (size)
+		pr_info("UDP: receive budget sized from L%u cache (%u KiB)\n",
+			level, size >> 10);
