+/* UDP receive buffer autotuning, in both directions.
+ *
+ * TCP sizes sk_rcvbuf from its own RTT clock (tcp_rcvbuf_grow); UDP has no
+ * such clock, so the only signal available to the producer is how full the
+ * queue already is.  When the producer finds the queue more than half full the
+ * consumer is losing to the arrival burst, so double sk_rcvbuf rather than
+ * drop at whatever static value rmem_default happened to be; when it finds the
+ * queue below an eighth the buffer is oversized and half of it goes back.
+ *
+ * Growth stops at whichever bound comes first: the per-socket ceiling
+ * net.ipv4.udp_rmem_autotune_max, or the global cache budget above.  The
+ * second is the one that matters - a per-socket limit cannot express "eight
+ * sockets at 4MB is too much" when 4MB is perfectly fine for one.
+ *
+ * Off by default (net.ipv4.udp_rmem_autotune) so that the kernel matches
+ * upstream behaviour unless the knob is set.  A socket that set SO_RCVBUF
+ * keeps exactly what it asked for, but is charged for it - see below.
+ */
+static unsigned int udp_rcvbuf_autotune(struct sock *sk, unsigned int rmem,
+					unsigned int rcvbuf)
