@@ -2202,11 +2202,47 @@
 	return -1;
 }
 
+/* Early drop (opt-in): if the socket receive buffer is already full,
+ * every segment of this (super-)skb would be dropped at enqueue anyway -
+ * but only after paying for GSO re-segmentation, checksum validation and
+ * per-segment queue attempts, all of which steal CPU from the consumer
+ * that is trying to drain the very same queue (receive livelock).
+ * Shed the whole skb up front, mirroring enqueue-failure accounting.
+ * Encap sockets are exempt: their skbs are consumed by the tunnel
+ * callback, not queued to this socket's receive buffer.
+ */
+static bool udp_early_drop(struct sock *sk, struct sk_buff *skb)
+{
+	int is_udplite = IS_UDPLITE(sk);
+	struct net *net = sock_net(sk);
+	int segs;
+
+	if (!READ_ONCE(net->ipv4.sysctl_udp_early_drop))
+		return false;
+	if (static_branch_unlikely(&udp_encap_needed_key) &&
+	    READ_ONCE(udp_sk(sk)->encap_type))
+		return false;
+	if (atomic_read(&sk->sk_rmem_alloc) <= READ_ONCE(sk->sk_rcvbuf))
+		return false;
+
+	segs = skb_is_gso(skb) ? skb_shinfo(skb)->gso_segs : 1;
+	atomic_add(segs, &sk->sk_drops);
+	while (segs--) {
+		__UDP_INC_STATS(net, UDP_MIB_RCVBUFERRORS, is_udplite);
+		__UDP_INC_STATS(net, UDP_MIB_INERRORS, is_udplite);
+	}
+	kfree_skb_reason(skb, SKB_DROP_REASON_SOCKET_RCVBUFF);
+	return true;
+}
+
 static int udp_queue_rcv_skb(struct sock *sk, struct sk_buff *skb)
 {
 	struct sk_buff *next, *segs;
 	int ret;
 
+	if (udp_early_drop(sk, skb))
+		return 0;
+
 	if (likely(!udp_unexpected_gso(sk, skb)))
 		return udp_queue_rcv_one_skb(sk, skb);
 
