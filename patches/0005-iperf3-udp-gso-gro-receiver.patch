+/* One recvmsg drains a whole coalesced super-skb; split by gso_size. */
+static int
+iperf_udp_recv_gro(struct iperf_stream *sp)
+{
+    struct iperf_test *test = sp->test;
+    struct msghdr msg;
+    struct iovec iov;
+    char ctrl[CMSG_SPACE(sizeof(int))];
+    struct cmsghdr *cm;
+    int gso = 0, off, seg, r;
+
+    int total = 0, ndrain = 0;
+
+    /* Drain all currently-available datagrams in one call so iperf's per-recv
+     * event-loop (select) overhead is amortized over many recvmsgs -- like a
+     * tight recv loop. First recvmsg honours the socket mode; the rest are
+     * MSG_DONTWAIT and stop at EAGAIN. */
+    for (;;) {
+        struct iperf_time arrival_time;
+
+        iov.iov_base = iperf_udp_gro_buf;
+        iov.iov_len = sizeof(iperf_udp_gro_buf);
+        memset(&msg, 0, sizeof(msg));
+        msg.msg_iov = &iov;
+        msg.msg_iovlen = 1;
+        msg.msg_control = ctrl;
+        msg.msg_controllen = sizeof(ctrl);
+
+        r = recvmsg(sp->socket, &msg, total ? MSG_DONTWAIT : 0);
+        if (r <= 0)
+            break;
+        total += r;
+
+        if (test->state != TEST_RUNNING)
+            continue;
+
+        gso = 0;
+        for (cm = CMSG_FIRSTHDR(&msg); cm != NULL; cm = CMSG_NXTHDR(&msg, cm))
+            if (cm->cmsg_level == IPPROTO_UDP && cm->cmsg_type == UDP_GRO)
+                memcpy(&gso, CMSG_DATA(cm), sizeof(gso));
+
+        iperf_time_now(&arrival_time);   /* once per recvmsg, not per segment */
+        seg = (gso > 0) ? gso : r;
+        for (off = 0; off < r; off += seg) {
+            int len = (r - off < seg) ? (r - off) : seg;
+            iperf_udp_process_pkt(sp, iperf_udp_gro_buf + off, len, &arrival_time);
+        }
+        if (++ndrain >= 256)   /* fairness cap across streams */
+            break;
+    }
+
+    return total > 0 ? total : r;
+}
