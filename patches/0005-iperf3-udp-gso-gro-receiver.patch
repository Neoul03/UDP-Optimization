+/* Helper function to get interface MTU */
+static int
+get_interface_mtu(const char *ifname)
+{
+#ifdef __linux__
+    struct ifreq ifr;
+    int sock;
+    int mtu = 1500; /* default MTU */
+
+    if (ifname == NULL)
+	return mtu;
+
+    sock = socket(AF_INET, SOCK_DGRAM, 0);
+    if (sock < 0)
+	return mtu;
+
+    strncpy(ifr.ifr_name, ifname, IFNAMSIZ - 1);
+    ifr.ifr_name[IFNAMSIZ - 1] = '\0';
+
+    if (ioctl(sock, SIOCGIFMTU, &ifr) == 0) {
+	mtu = ifr.ifr_mtu;
+    }
+
+    close(sock);
+    return mtu;
+#else
+    return 1500; /* default MTU */
+#endif
+}
