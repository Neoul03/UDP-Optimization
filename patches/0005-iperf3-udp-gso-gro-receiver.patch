+#ifndef UDP_GRO
+#define UDP_GRO 104
+#endif
+
+/* --- opt-in kernel UDP_GRO receive (TCP-like: one recvmsg drains a coalesced
+ * super-skb of many datagrams; gso_size cmsg gives the per-datagram size).
+ * Enabled via env IPERF3_UDP_GRO=1 (single-stream UDP test). --- */
+static int  iperf_udp_gro = -1;            /* -1 unknown, 0 off, 1 on */
+static char iperf_udp_gro_buf[262144];
+static int  iperf_udp_seg_size = 0;        /* TX GSO segment size (0 = GSO off) */
+
+/* RX GRO is ON by default in this build (complete GSO+GRO iperf). Set
+ * IPERF3_UDP_GRO=0 to force the legacy per-datagram recv path (for A/B). */
+static int
+udp_gro_on(void)
+{
+    if (iperf_udp_gro < 0) {
+        const char *e = getenv("IPERF3_UDP_GRO");
+        iperf_udp_gro = (e && e[0] == '0') ? 0 : 1;
+    }
+    return iperf_udp_gro;
+}
+
+/* Per-datagram accounting (header, seqno/loss, jitter, bytes) — mirrors the
+ * inline logic of the normal recv path, operating on an arbitrary buffer so it
+ * can be called once per coalesced segment. */
+static void
+iperf_udp_process_pkt(struct iperf_stream *sp, char *buf, int r,
+		      struct iperf_time *arrival_time)
+{
+    struct iperf_test *test = sp->test;
+    uint32_t sec, usec;
+    uint64_t pcount;
+    int first_packet = 0;
+    double transit = 0, d = 0;
+    struct iperf_time sent_time, temp_time;
+
+    if (sp->result->bytes_received == 0)
+        first_packet = 1;
+
+    sp->result->bytes_received += r;
+    sp->result->bytes_received_this_interval += r;
+
+    if (test->udp_counters_64bit) {
+        memcpy(&sec, buf, sizeof(sec));
+        memcpy(&usec, buf + 4, sizeof(usec));
+        memcpy(&pcount, buf + 8, sizeof(pcount));
+        sec = ntohl(sec);
+        usec = ntohl(usec);
+        pcount = be64toh(pcount);
+        sent_time.secs = sec;
+        sent_time.usecs = usec;
+    } else {
+        uint32_t pc;
+        memcpy(&sec, buf, sizeof(sec));
+        memcpy(&usec, buf + 4, sizeof(usec));
+        memcpy(&pc, buf + 8, sizeof(pc));
+        sec = ntohl(sec);
+        usec = ntohl(usec);
+        pcount = ntohl(pc);
+        sent_time.secs = sec;
+        sent_time.usecs = usec;
+    }
+
+    if (pcount >= sp->packet_count + 1) {
+        if (pcount > sp->packet_count + 1)
+            sp->cnt_error += (pcount - 1) - sp->packet_count;
+        sp->packet_count = pcount;
+    } else {
+        sp->outoforder_packets++;
+        if (sp->cnt_error > 0)
+            sp->cnt_error--;
+    }
+
+    iperf_time_diff(arrival_time, &sent_time, &temp_time);
+    transit = iperf_time_in_secs(&temp_time);
+    if (first_packet)
+        sp->prev_transit = transit;
+    d = transit - sp->prev_transit;
+    if (d < 0)
+        d = -d;
+    sp->prev_transit = transit;
+    sp->jitter += (d - sp->jitter) / 16.0;
+}
