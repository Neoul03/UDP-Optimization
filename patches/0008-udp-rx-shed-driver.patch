+/* Driver-level RX shed (prototype, see include/net/udp.h). 200us window,
+ * renewed for as long as enqueue keeps failing - self-clocking pulse.
+ */
+struct udp_rx_shed_slot udp_rx_shed[UDP_RX_SHED_MAX_QUEUES];
+EXPORT_SYMBOL_GPL(udp_rx_shed);
+
+#define UDP_RX_SHED_WINDOW_NS	(200 * NSEC_PER_USEC)
+
+void udp_rx_shed_mark(const struct sock *sk)
+{
+	int q = sk_rx_queue_get(sk);
+
+	if (q < 0 || q >= UDP_RX_SHED_MAX_QUEUES)
+		q = 0;
+	WRITE_ONCE(udp_rx_shed[q].until_ns,
+		   ktime_get_mono_fast_ns() + UDP_RX_SHED_WINDOW_NS);
+}
+
 /* Early drop (opt-in): if the socket receive buffer is already full,
  * every segment of this (super-)skb would be dropped at enqueue anyway -
  * but only after paying for GSO re-segmentation, checksum validation and
