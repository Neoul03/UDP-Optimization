 static void mlx5e_handle_rx_cqe(struct mlx5e_rq *rq, struct mlx5_cqe64 *cqe);
+
+/* UDP RX shed (prototype): drop at CQE level - before skb alloc/build, GRO
+ * and stack traversal - while the UDP layer signals receive-buffer overflow
+ * on this queue. The consumed WQE is recycled exactly like the !skb path.
+ */
+static inline bool mlx5e_udp_rx_shed(struct mlx5e_rq *rq)
+{
+	u64 until;
+
+	if (rq->ix >= UDP_RX_SHED_MAX_QUEUES)
+		return false;
+	until = READ_ONCE(udp_rx_shed[rq->ix].until_ns);
+	if (likely(!until))
+		return false;
+	if (ktime_get_mono_fast_ns() < until)
+		return true;
+	WRITE_ONCE(udp_rx_shed[rq->ix].until_ns, 0);
+	return false;
+}
 static void mlx5e_handle_rx_cqe_mpwrq(struct mlx5e_rq *rq, struct mlx5_cqe64 *cqe);
 static void mlx5e_handle_rx_cqe_mpwrq_shampo(struct mlx5e_rq *rq, struct mlx5_cqe64 *cqe);
 
