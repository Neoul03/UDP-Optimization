+
+/* Driver-level RX shedding (prototype): when a UDP socket's receive buffer
+ * overflows, the UDP layer stamps a short shed window for the RX queue that
+ * feeds it; the NIC driver drops packets of that queue before building skbs,
+ * so overload is shed at ~zero CPU cost instead of after full stack traversal.
+ */
+#define UDP_RX_SHED_MAX_QUEUES	256
+struct udp_rx_shed_slot {
+	u64 until_ns;
+} ____cacheline_aligned_in_smp;
+extern struct udp_rx_shed_slot udp_rx_shed[UDP_RX_SHED_MAX_QUEUES];
+void udp_rx_shed_mark(const struct sock *sk);
 extern int sysctl_udp_wmem_min;
 
