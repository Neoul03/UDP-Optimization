+/* Opt-in UDP_RECV_BATCH socket option. Lets a single recvmsg() drain MANY
+ * datagrams into one large user buffer (TCP recvmsg style): the syscall and
+ * recvmsg machinery are paid once, then a tight dequeue+copy loop fills the
+ * buffer. Datagrams are delivered concatenated, so this only makes sense for
+ * callers that know the datagram size (fixed-size workloads). Kept entirely
+ * inside udp.c (spare udp_flags bit + literal optname) to avoid uAPI/header
+ * churn and keep the kernel rebuild incremental.
+ */
+#define UDP_RECV_BATCH		105	/* setsockopt(IPPROTO_UDP, ...) */
+#define UDP_FLAGS_RECV_BATCH	24	/* spare bit in udp_sk()->udp_flags */
+
+static int udp_recvmsg_batch(struct sock *sk, struct msghdr *msg, size_t len,
+			     int flags, int *addr_len)
+{
+	DECLARE_SOCKADDR(struct sockaddr_in *, sin, msg->msg_name);
+	int is_udplite = IS_UDPLITE(sk);
+	bool addr_filled = false;
+	unsigned int batch = 0;
+	int total = 0, err = 0;
+
+	for (;;) {
+		bool checksum_valid = false;
+		unsigned int ulen, copied;
+		struct sk_buff *skb;
+		int off = 0;
+
+		/* Keep room for a full max-sized datagram so we never split one
+		 * across calls; once the buffer is nearly full, stop cleanly.
+		 */
+		if (batch && msg_data_left(msg) < (1 << 16))
+			break;
+
+		/* First dequeue honours the caller's blocking mode; later ones
+		 * are non-blocking so a partially-filled batch returns at once.
+		 */
+		skb = __skb_recv_udp(sk, batch ? (flags | MSG_DONTWAIT) : flags,
+				     &off, &err);
+		if (!skb)
+			break;
+
+		ulen = udp_skb_len(skb);
+		copied = ulen;
+		if (copied > msg_data_left(msg))
+			copied = msg_data_left(msg);
+
+		if (copied < ulen) {
+			checksum_valid = udp_skb_csum_unnecessary(skb) ||
+					 !__udp_lib_checksum_complete(skb);
+			if (!checksum_valid)
+				goto csum_err;
+		}
+
+		if (checksum_valid || udp_skb_csum_unnecessary(skb)) {
+			if (udp_skb_is_linear(skb))
+				err = copy_linear_skb(skb, copied, off,
+						      &msg->msg_iter);
+			else
+				err = skb_copy_datagram_msg(skb, off, msg, copied);
+		} else {
+			err = skb_copy_and_csum_datagram_msg(skb, off, msg);
+			if (err == -EINVAL)
+				goto csum_err;
+		}
+
+		if (unlikely(err)) {
+			atomic_inc(&sk->sk_drops);
+			UDP_INC_STATS(sock_net(sk), UDP_MIB_INERRORS, is_udplite);
+			kfree_skb(skb);
+			break;
+		}
+
+		UDP_INC_STATS(sock_net(sk), UDP_MIB_INDATAGRAMS, is_udplite);
+
+		/* Peer address + cmsgs from the first datagram only. */
+		if (sin && !addr_filled) {
+			sin->sin_family = AF_INET;
+			sin->sin_port = udp_hdr(skb)->source;
+			sin->sin_addr.s_addr = ip_hdr(skb)->saddr;
+			memset(sin->sin_zero, 0, sizeof(sin->sin_zero));
+			*addr_len = sizeof(*sin);
+			addr_filled = true;
+		}
+		if (!batch)
+			sock_recv_cmsgs(msg, sk, skb);
+
+		total += copied;
+		batch++;
+		skb_consume_udp(sk, skb, copied);
+
+		if (msg_data_left(msg) == 0)
+			break;
+		continue;
+
+csum_err:
+		if (!__sk_queue_drop_skb(sk, &udp_sk(sk)->reader_queue, skb,
+					 flags, udp_skb_destructor)) {
+			UDP_INC_STATS(sock_net(sk), UDP_MIB_CSUMERRORS, is_udplite);
+			UDP_INC_STATS(sock_net(sk), UDP_MIB_INERRORS, is_udplite);
+		}
+		kfree_skb(skb);
+		/* keep draining the rest of the batch */
+	}
+
+	if (total)
+		return total;
+	return err ? err : -EAGAIN;
+}
